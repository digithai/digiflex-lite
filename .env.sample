# DigiFlex Lite — Environment Template
# Copy this file to `.env` and fill in your own values.
# Never commit real secrets to version control.

NODE_ENV=production
PORT=7088

# MongoDB connection string.
# Use the database name `digiflex-lite`, not the container name `digiflex-lite-db`.
MONGO_URI=mongodb://digiflex-lite-db:27017/digiflex-lite

# Generate with: openssl rand -base64 64
JWT_SECRET=
JWT_REFRESH_SECRET=

# Gmail credentials for sending notifications. Use an app password, not your regular password.
EMAIL_USER=
EMAIL_PASS=

# Address that receives password recovery requests
RECOVERY_EMAIL=

# Admin credentials for the crypt.js seed script
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email shown to users for sick leave medical certificates (frontend only)
VITE_HR_EMAIL=hr@example.com

# URL included in email notification links
FRONTEND_URL=http://localhost:7091

# URL the React client uses to reach the API
VITE_BASE_URL=http://localhost:7088
